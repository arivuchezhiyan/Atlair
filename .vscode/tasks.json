{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Node Server",
            "type": "shell",
            "command": "node",
            "args": [
                "server.js"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^([^\\\\s].*)\\\\((\\\\d+),(\\\\d+)\\\\):\\\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Server running.*$",
                    "endsPattern": "^.*Server running.*$"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}